<%# Comment Section Component %>
<section class="comments-section">
    <h2>Customer Comments</h2>
    
    <%# Add Comment Form (if user is logged in) %>
    <% if (user) { %>
        <div class="add-comment-form">
            <h3>Add Your Comment</h3>
            <form action="/comment/add" method="POST">
                <input type="hidden" name="inv_id" value="<%= invId %>">
                <div class="form-group">
                    <label for="comment_text">Your Comment:</label>
                    <textarea 
                        name="comment_text" 
                        id="comment_text" 
                        rows="4" 
                        cols="50" 
                        placeholder="Share your thoughts about this vehicle..."
                        required
                    ></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Add Comment</button>
            </form>
        </div>
        <hr>
    <% } %>
    
    <%# Display Comments %>
    <div class="comments-list">
        <% if (comments && comments.length > 0) { %>
            <h3>What Our Customers Are Saying</h3>
            <% comments.forEach(comment => { %>
                <div class="comment-item" id="comment-<%= comment.comment_id %>">
                    <div class="comment-header">
                        <strong class="comment-author">
                            <%= comment.account_firstname %> <%= comment.account_lastname %>
                        </strong>
                        <span class="comment-date">
                            <%= new Date(comment.comment_date).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </span>
                    </div>
                    
                    <div class="comment-body">
                        <p><%= comment.comment_text %></p>
                    </div>
                    
                    <div class="comment-actions">
                        <%# Like/Unlike functionality %>
                        <% if (user) { %>
                            <form class="like-form" action="/comment/like" method="POST" style="display: inline;">
                                <input type="hidden" name="comment_id" value="<%= comment.comment_id %>">
                                <input type="hidden" name="inv_id" value="<%= invId %>">
                                <button type="submit" class="like-btn <%= comment.hasLiked ? 'liked' : '' %>">
                                    <span class="like-icon">👍</span>
                                    <span class="like-count"><%= comment.like_count || 0 %></span>
                                </button>
                            </form>
                        <% } else { %>
                            <span class="like-display">
                                👍 <span class="like-count"><%= comment.like_count || 0 %></span>
                            </span>
                        <% } %>
                        
                        <%# Edit/Delete for comment owner or admin %>
                        <% if (user && (user.account_id === comment.account_id || user.account_type === 'Admin')) { %>
                            <a href="/comment/edit/<%= comment.comment_id %>" class="btn-edit">Edit</a>
                            <form class="delete-form" action="/comment/delete" method="POST" style="display: inline;">
                                <input type="hidden" name="comment_id" value="<%= comment.comment_id %>">
                                <input type="hidden" name="inv_id" value="<%= invId %>">
                                <button type="submit" class="btn-delete" 
                                        onclick="return confirm('Are you sure you want to delete this comment?')">
                                    Delete
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
                <hr class="comment-divider">
            <% }) %>
        <% } else { %>
            <p class="no-comments">No comments yet. Be the first to share your thoughts!</p>
        <% } %>
    </div>
    
    <%# Login prompt for non-logged-in users %>
    <% if (!user) { %>
        <div class="login-prompt">
            <p>Want to add a comment? <a href="/account/login">Log in</a> or <a href="/account/register">create an account</a></p>
        </div>
    <% } %>
</section>

<style>
.comments-section {
    margin: 2rem 0;
    padding: 1rem;
    background: #f9f9f9;
    border-radius: 8px;
}

.add-comment-form {
    margin-bottom: 2rem;
    padding: 1rem;
    background: white;
    border-radius: 5px;
    border: 1px solid #ddd;
}

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
}

.form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-family: inherit;
    resize: vertical;
}

.comment-item {
    background: white;
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 5px;
    border: 1px solid #eee;
}

.comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.comment-author {
    color: #333;
    font-size: 1rem;
}

.comment-date {
    color: #666;
    font-size: 0.85rem;
}

.comment-body {
    margin: 0.75rem 0;
    line-height: 1.5;
}

.comment-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
}

.like-form, .delete-form {
    display: inline;
}

.like-btn, .btn-edit, .btn-delete {
    padding: 0.25rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #f8f9fa;
    cursor: pointer;
    text-decoration: none;
    color: #333;
    font-size: 0.9rem;
}

.like-btn:hover, .btn-edit:hover {
    background: #e9ecef;
}

.like-btn.liked {
    background: #e3f2fd;
    border-color: #2196f3;
}

.btn-delete {
    background: #ffebee;
    border-color: #f44336;
    color: #c62828;
}

.btn-delete:hover {
    background: #ffcdd2;
}

.like-display {
    color: #666;
    font-size: 0.9rem;
}

.comment-divider {
    border: none;
    border-top: 1px solid #eee;
    margin: 1rem 0;
}

.no-comments {
    text-align: center;
    color: #666;
    font-style: italic;
    padding: 2rem;
}

.login-prompt {
    text-align: center;
    margin-top: 2rem;
    padding: 1rem;
    background: #fff3e0;
    border-radius: 5px;
    border: 1px solid #ffb74d;
}

.login-prompt a {
    color: #f57c00;
    text-decoration: none;
}

.login-prompt a:hover {
    text-decoration: underline;
}

.btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
}

.btn-primary {
    background: #007bff;
    color: white;
}

.btn-primary:hover {
    background: #0056b3;
}

@media (max-width: 768px) {
    .comment-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }
    
    .comment-actions {
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    
    .form-group textarea {
        min-height: 100px;
    }
}
</style>