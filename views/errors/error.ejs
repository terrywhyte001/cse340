<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <style>
    body { font-family: Arial, sans-serif; background:#f8f8f8; display:flex; justify-content:center; align-items:center; height:100vh; margin:0; }
    .container { background:#fff; padding:2rem; border-radius:8px; box-shadow:0 0 10px rgba(0,0,0,0.1); text-align:center; }
    h1 { color:#e74c3c; font-size:2rem; }
    p { margin:1rem 0; font-size:1.2rem; }
    a { display:inline-block; margin-top:1rem; padding:0.5rem 1rem; background:#3498db; color:#fff; text-decoration:none; border-radius:4px; }
    a:hover { background:#2980b9; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Error</h1>
    <p><%= message %></p>
    <a href="/inventory">Back to Inventory</a>
  </div>
</body>
</html>


